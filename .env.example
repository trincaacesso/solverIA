# Modelo das variáveis de ambiente do projeto.
#
# COMO USAR: copie este arquivo para .env.local (esse sim é ignorado pelo
# Git e nunca sai da sua máquina) e preencha com os valores do seu
# projeto no Supabase, em Project Settings -> API.
#
#   cp .env.example .env.local


# ── Públicas ─────────────────────────────────────────────────────────
# Tudo que começa com NEXT_PUBLIC_ é embutido no JavaScript do site e
# dentro do APK. Ou seja: qualquer pessoa consegue ler. Isso é normal e
# esperado — quem protege os dados é a RLS do banco, não estas chaves.
# Estas duas TAMBÉM precisam ser cadastradas na Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public


# ── Secretas — NUNCA vão para a Vercel, para o app nem para o Git ────

# Ignora TODAS as regras de segurança do banco. Serve só para o script
# scripts/seed-supabase.mjs rodar na sua máquina, uma vez.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service-role

# Senha do professor (usuário admin "vitorhugo"), usada na carga inicial.
# Escolha uma nova, com 10+ caracteres. NÃO reaproveite a antiga: ela
# estava escrita dentro do código e ia junto no JavaScript do site, além
# de continuar no histórico do Git. Considere-a vazada.
ADMIN_PASSWORD=


# ── Push no iOS ──────────────────────────────────────────────────────
# Fica desligado. Só vire "1" depois de assinar a conta Apple Developer
# (US$ 99/ano) e configurar a chave APNs no Firebase — sem isso, a Apple
# não entrega notificação nenhuma.
NEXT_PUBLIC_PUSH_IOS=0
